{
  "name": "aircnc-backend",
  "version": "1.0.0",
  "description": "API REST do AirCnC em Node.js com Express, Mongoose e Socket.IO",
  "license": "ISC",
  "author": "João Mateus Firmino Rodrigues",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "clearMocks": true
  },
  "engines": {
    "node": ">=18"
  }
}
