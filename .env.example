# copie para .env e preencha; so MONGO_URI e obrigatoria, o resto tem padrao

# string de conexao do MongoDB (Atlas ou local). obrigatoria
MONGO_URI=mongodb://localhost:27017/aircnc

# development, production ou test (padrao development)
# em production o 500 nao devolve mensagem nem stack do erro
NODE_ENV=development

# porta do servidor HTTP (padrao 3333; 0 escolhe uma porta livre)
PORT=3333

# url publica da api, usada para montar thumbnail_url (padrao http://localhost:PORT)
APP_URL=http://localhost:3333

# origens liberadas no CORS e no Socket.IO, separadas por virgula, ou * para liberar tudo
CLIENT_URL=http://localhost:5173

# true se a api roda atras de proxy reverso, para o rate limit usar o ip do X-Forwarded-For (padrao false)
TRUST_PROXY=false

# pasta das imagens enviadas, relativa a raiz do projeto ou absoluta (padrao uploads)
UPLOAD_DIR=uploads

# tamanho maximo da imagem em MB (padrao 2)
UPLOAD_MAX_MB=2

# tipos aceitos no upload, separados por virgula (padrao image/jpeg,image/png,image/webp; image/gif tambem e suportado)
UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp

# rate limit por ip: janela em ms e maximo de requisicoes na janela (padrao 15 min e 300)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# tempo maximo de cada tentativa de conexao com o mongo e intervalo entre tentativas, em ms (padrao 5000 e 10000)
DB_CONNECT_TIMEOUT_MS=5000
DB_RETRY_MS=10000

# debug, info, warn, error ou silent (padrao info; em test, silent)
LOG_LEVEL=info
